<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>

<!-- A plain TableView on purpose: ControlsFX FilteredTableView (TableView2) re-enters
     VirtualFlow.layoutChildren() from TableRow2Skin.layoutChildren() when it auto-fits row heights.
     Since JavaFX 25 VirtualFlow.cleanPile() removes the pooled cells from the sheet's children
     during that nested call, which makes the enclosing Parent.layout() iterate a stale child count
     and throw an IndexOutOfBoundsException. The per-column popup filters TableView2 provided are
     replaced by the single search field built in EdgeTableController#initialize. -->
<BorderPane fx:id="mainPane" prefHeight="474.0" prefWidth="746.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.mzmine.modules.visualization.network_overview.EdgeTableController">
   <center>
      <TableView fx:id="edgeTable" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colId1" editable="false" prefWidth="75.0" text="ID1" />
            <TableColumn fx:id="colId2" editable="false" prefWidth="75.0" text="ID2" />
            <TableColumn fx:id="colDeltaMz" editable="false" prefWidth="100.0" text="Δm/z" />
            <TableColumn fx:id="colScore" editable="false" prefWidth="75.0" text="Score" />
            <TableColumn fx:id="colExplainedIntensity" editable="false" prefWidth="75.0" text="Explained intensity" />
            <TableColumn fx:id="colMatchedSignals" editable="false" prefWidth="75.0" text="Matched signals" />
            <TableColumn fx:id="colType" editable="false" prefWidth="120" text="Type" />
            <TableColumn fx:id="colLabel" editable="false" prefWidth="120" text="Label" />
            <TableColumn fx:id="colNeighborDistance" editable="false" prefWidth="75.0" text="Distance" />
         </columns>
      </TableView>
   </center>
</BorderPane>
