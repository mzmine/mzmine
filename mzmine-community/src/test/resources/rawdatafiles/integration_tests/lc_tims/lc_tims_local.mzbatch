    <batchstep method="io.github.mzmine.modules.dataprocessing.id_spectral_library_match.SpectralLibrarySearchModule" module_name="Spectral library search" parameter_version="3">
        <parameter name="Spectral libraries" type="ALL_IMPORTED"/>
        <parameter name="Feature lists" type="BATCH_LAST_FEATURELISTS"/>
