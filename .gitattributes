# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.java text
*.fxml text
*.html text
*.c text
*.h text
*.cpp text
*.cs text
*.txt text
*.bat text

# Encoded csv/tsv test fixtures. They must keep their exact bytes (byte order mark, encoding
# and line endings), so git must not normalize them.
mzmine-community/src/test/resources/csv/encodings/*.csv -text
mzmine-community/src/test/resources/csv/encodings/*.tsv -text
